<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F4"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gold Details"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep = 85g | Wear = 200g"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please enter all fields before calculation."
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gold Weight (gram)"
            android:backgroundTint="#0B6B4A"
            android:inputType="numberDecimal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#0B6B4A"
            android:layout_marginTop="20dp"/>

        <Spinner
            android:id="@+id/spJenis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"/>

        <EditText
            android:id="@+id/etValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Current Gold Value per Gram"
            android:backgroundTint="#0B6B4A"
            android:inputType="numberDecimal"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Calculate Zakat"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B4A"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Reset"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B4A"/>

        <!-- Total Gold Value -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Gold Value"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#0B6B4A"
            android:layout_marginTop="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:text="RM"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#0B6B4A"
                android:gravity="center"
                android:background="#DCEEE5"/>

            <TextView
                android:id="@+id/tvGoldValue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0.00"
                android:textSize="18sp"
                android:textColor="#0B6B4A"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:background="#EEF8F1"/>
        </LinearLayout>

        <!-- Zakat Payable Value -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zakat Payable Value"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#0B6B4A"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:text="RM"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#0B6B4A"
                android:gravity="center"
                android:background="#DCEEE5"/>

            <TextView
                android:id="@+id/tvPayable"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0.00"
                android:textSize="18sp"
                android:textColor="#0B6B4A"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:background="#EEF8F1"/>
        </LinearLayout>

        <!-- Total Zakat -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Zakat"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#0B6B4A"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:text="RM"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#0B6B4A"
                android:gravity="center"
                android:background="#DCEEE5"/>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="0.00"
                android:textSize="18sp"
                android:textColor="#0B6B4A"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:background="#EEF8F1"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>